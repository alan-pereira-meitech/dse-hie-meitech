<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>Hbm.Automation.Api</RootNamespace>
    <TargetFrameworks>netstandard2.0;net45</TargetFrameworks>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AssemblyName>Hbm.Automation.Api</AssemblyName>
    <PackageId>Hbm.Automation.Api</PackageId>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Data\DataStandardJet.cs" />
    <Compile Remove="Data\DataStandardModbus.cs" />
    <!-- Remove WTX Modbus and Modbus data -->
    <Compile Remove="Weighing\WTX\Modbus\**\*.cs" />
    <Compile Remove="Weighing\WTX\WTXModbus.cs" />
    <Compile Remove="Data\ModbusData*.cs" />
    <!-- Remove WTX Jet device class (not used by DSE) but keep Jet commands/command types -->
    <Compile Remove="Weighing\WTX\WTXJet.cs" />
    <!-- Optional: remove Jet connection for WTX if DSE uses its own connection -->
    <Compile Remove="Weighing\WTX\Jet\JetBusConnection.cs" />
    <!-- Remove extended Jet Data types not used by DSE -->
    <Compile Remove="Data\JetDataFillerExtended.cs" />
    <Compile Remove="Data\JetDataLimitSwitch.cs" />
    <Compile Remove="Data\JetDataDigitalIO.cs" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="GitInfo" Version="2.1.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SharpJet" Version="2.0.0" />
  </ItemGroup>
  
  <ItemGroup>
    <None Update="Hbm.Automation.API.nuspec">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
