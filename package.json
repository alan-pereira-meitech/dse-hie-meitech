{
  "name": "dse-hie-meitech",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Dashboard JetBus com backend TypeScript e front-end React/Tailwind, incluindo build opcional para Electron.",
  "author": {
    "name": "Meitech",
    "email": "alan.pereira@meitech.com.br"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:client": "vite --config vite.config.ts --host",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node dist/index.js",
    "electron:dev": "npm run build && electron electron/main.js",
    "electron:build": "npm run build && electron-builder",
    "test": "vitest",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^29.1.6",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.5.0"
  },
  "build": {
    "appId": "com.dse.jetbus",
    "productName": "DSE JetBus Dashboard",
    "files": [
      "dist/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build-resources"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "linux": {
      "target": "deb",
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "Meitech alan.pereira@meitech.com.br"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
